---
import BaseLayout from "./BaseLayout.astro";
import TagList from "../components/TagList.astro";
import { formatDate } from "../lib/format";
import type { TocHeading } from "../lib/headings";

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  updatedDate?: Date;
  tags: string[];
  kind: string;
  toc: TocHeading[];
  tagBase: string;
  readingTime: number;
  backHref: string;
  backLabel: string;
  related?: Array<{
    title: string;
    description: string;
    url: string;
    kind: string;
  }>;
  repository?: string;
  sources?: string[];
  links?: Array<{ label: string; url: string }>;
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  tags,
  kind,
  toc,
  tagBase,
  readingTime,
  backHref,
  backLabel,
  related = [],
  repository,
  sources,
  links,
} = Astro.props;
---

<BaseLayout title={title} description={description} ogType="article">
  <a class="back-link" href={backHref}>← {backLabel}</a>
  <div class="split-layout">
    <article>
      <header class="article-header">
        <h1>{title}</h1>
        <p class="lead">{description}</p>
        <div class="article-meta">
          <span>{kind}</span>
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          {updatedDate && <time datetime={updatedDate.toISOString()}>改於 {formatDate(updatedDate)}</time>}
          <span>約 {readingTime} 分鐘</span>
        </div>
        <TagList tags={tags} base={tagBase} />
      </header>

      <div class="prose">
        <slot />
      </div>

      {(repository || sources?.length) && (
        <section class="source-list" aria-labelledby="sources-title">
          <strong id="sources-title">參考與連結</strong>
          {repository && <a href={repository} target="_blank" rel="noreferrer noopener">{repository}</a>}
          {sources?.map((source) => (
            <a href={source} target="_blank" rel="noreferrer noopener">{source}</a>
          ))}
          {links?.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer noopener">{link.label} · {link.url}</a>
          ))}
        </section>
      )}

      {related.length > 0 && (
        <section class="related-articles" aria-labelledby="related-title">
          <h2 id="related-title">再讀一點</h2>
          <div class="article-list">
            {related.map((item) => (
              <a class="article-row" href={item.url}>
                <span class="article-row-kind">{item.kind}</span>
                <span class="article-row-body">
                  <strong>{item.title}</strong>
                  <span>{item.description}</span>
                </span>
                <span class="article-row-arrow">↗</span>
              </a>
            ))}
          </div>
        </section>
      )}

      <a class="back-link back-link-bottom" href={backHref}>← {backLabel}</a>
    </article>

    {toc.length > 0 && (
      <aside class="toc" aria-label="文章目錄">
        <strong>On this page</strong>
        <ol>
          {toc.map((heading) => (
            <li class:list={[heading.depth === 3 && "toc-h3"]}>
              <a href={`#${heading.slug}`}>{heading.text}</a>
            </li>
          ))}
        </ol>
      </aside>
    )}
  </div>
</BaseLayout>
