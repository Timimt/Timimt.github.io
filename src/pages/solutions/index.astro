---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { formatDate } from "../../lib/format";
import {
  githubRepositoryPath,
  githubTroubleshooting,
} from "../../data/github-repos";
---

<BaseLayout title="問題紀錄" description="GitHub 上實際記錄過的問題排查與解決過程。">
  <header class="page-heading">
    <p class="page-kicker">GitHub 同步</p>
    <h1 class="page-title">問題紀錄</h1>
    <p class="page-description">
      這裡直接列出我 GitHub 上跟問題排查有關的 Repository。內容會在網站建置時同步。
    </p>
  </header>

  {githubTroubleshooting.length === 0 ? (
    <p class="empty-state">目前沒有公開的問題紀錄 Repository。</p>
  ) : (
    <div class="article-list">
      {githubTroubleshooting.map((repository) => (
        <a class="article-row" href={githubRepositoryPath(repository)}>
          <time class="article-row-date" datetime={repository.pushedAt}>
            {formatDate(repository.pushedAt)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">{repository.language ?? "GitHub Repository"}</span>
            <strong>{repository.title}</strong>
            <span>{repository.description}</span>
            <span class="article-row-tags">{repository.topics.slice(0, 4).join(" · ")}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
