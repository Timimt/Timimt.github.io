---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byNewest, publishedPosts, solutionCategoryLabel } from "../../lib/collections";
import { formatDate } from "../../lib/format";

const selectedCategory = Astro.url.searchParams.get("category");
const entries = byNewest(publishedPosts(await getCollection("solutions")));
const filtered = selectedCategory
  ? entries.filter((entry) => entry.data.category === selectedCategory)
  : entries;
const categories = [...new Set(entries.map((entry) => entry.data.category))];
---

<BaseLayout title="問題與解法" description="真的修到卡住過的問題，以及最後怎麼解決。">
  <header class="page-heading">
    <p class="page-kicker">踩坑紀錄</p>
    <h1 class="page-title">問題與解決方案</h1>
    <p class="page-description">
      我不寫那種一路順利的教程。這裡的每一篇，都是我實際遇到、卡住、最後想辦法修好的問題。
    </p>
  </header>

  <div class="filter-strip" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.4rem">
    <a class:list={["tag-pill", !selectedCategory && "tag-pill-accent"]} href="/solutions">全部</a>
    {categories.map((category) => (
      <a
        class:list={["tag-pill", selectedCategory === category && "tag-pill-accent"]}
        href={`/solutions?category=${category}`}
      >
        {solutionCategoryLabel(category)}
      </a>
    ))}
  </div>

  {filtered.length === 0 ? (
    <p class="empty-state">這個分類還沒有文章。</p>
  ) : (
    <div class="article-list">
      {filtered.map((entry) => (
        <a class="article-row" href={`/solutions/${entry.id}/`}>
          <time class="article-row-date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">{solutionCategoryLabel(entry.data.category)}</span>
            <strong>{entry.data.title}</strong>
            <span>{entry.data.description}</span>
            <span class="article-row-tags">{entry.data.tags.slice(0, 3).join(" · ")}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
