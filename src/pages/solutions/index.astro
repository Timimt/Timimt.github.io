---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { byNewest, publishedPosts, solutionCategoryLabel } from "../../lib/collections";

const selectedCategory = Astro.url.searchParams.get("category");
const entries = byNewest(publishedPosts(await getCollection("solutions")));
const filtered = selectedCategory
  ? entries.filter((entry) => entry.data.category === selectedCategory)
  : entries;
const categories = [...new Set(entries.map((entry) => entry.data.category))];
---

<BaseLayout title="Problem & Solutions" description="實際踩過的技術問題、錯誤現象、原因分析與最終解法。">
  <header class="page-heading">
    <p class="page-kicker">Solutions</p>
    <h1 class="page-title">問題與解決方案</h1>
    <p class="page-description">
      每一篇都來自真實遇到的問題：背景、錯誤訊息、原因、排查過程與最後有效的解法。
    </p>
  </header>

  <div class="filter-strip" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.4rem">
    <a class:list={["tag-pill", !selectedCategory && "tag-pill-accent"]} href="/solutions">全部</a>
    {categories.map((category) => (
      <a
        class:list={["tag-pill", selectedCategory === category && "tag-pill-accent"]}
        href={`/solutions?category=${category}`}
      >
        {solutionCategoryLabel(category)}
      </a>
    ))}
  </div>

  {filtered.length === 0 ? (
    <p class="empty-state">這個分類還沒有文章。</p>
  ) : (
    <div class="card-grid">
      {filtered.map((entry) => (
        <PostCard
          href={`/solutions/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          pubDate={entry.data.pubDate}
          tags={entry.data.tags}
          kind={solutionCategoryLabel(entry.data.category)}
          tagBase="/solutions"
        />
      ))}
    </div>
  )}
</BaseLayout>
