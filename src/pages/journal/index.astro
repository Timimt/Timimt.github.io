---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byNewest, publishedPosts } from "../../lib/collections";
import { formatDate } from "../../lib/format";

const entries = byNewest(publishedPosts(await getCollection("journal")));
---

<BaseLayout title="生活與隨筆" description="大學生活、旅行、日常觀察，還有一些不想忘記的想法。">
  <header class="page-heading">
    <p class="page-kicker">生活</p>
    <h1 class="page-title">生活與隨筆</h1>
    <p class="page-description">
      這裡不是技術專欄。只是一些日常、走過的地方，還有當下覺得值得記下來的事。
    </p>
  </header>

  {entries.length === 0 ? (
    <p class="empty-state">還沒有生活隨筆。</p>
  ) : (
    <div class="article-list">
      {entries.map((entry) => (
        <a class="article-row" href={`/journal/${entry.id}/`}>
          <time class="article-row-date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
          <span class="article-row-body">
            <strong>{entry.data.title}</strong>
            <span>{entry.data.description}</span>
            <span class="article-row-tags">{entry.data.tags.join(" · ")}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
