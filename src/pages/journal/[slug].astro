---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { readingTime } from "../../lib/collections";
import { extractHeadings } from "../../lib/headings";

export async function getStaticPaths() {
  const entries = await getCollection("journal");
  return entries
    .filter((entry) => entry.data.status !== "draft")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const headings = extractHeadings(entry.body ?? "");
const all = (await getCollection("journal")).filter((item) => item.data.status !== "draft");
const related = all
  .filter((item) => item.id !== entry.id)
  .slice(0, 2)
  .map((item) => ({
    title: item.data.title,
    description: item.data.description,
    url: `/journal/${item.id}/`,
    kind: "生活",
  }));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  kind={entry.data.mood ?? "生活"}
  toc={headings}
  tagBase="/journal"
  readingTime={readingTime(entry.body ?? "")}
  backHref="/journal"
  backLabel="回到生活隨筆"
  related={related}
>
  <Content />
</ArticleLayout>
