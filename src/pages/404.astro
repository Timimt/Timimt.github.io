---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="找不到頁面">
  <div class="empty-state" style="margin-top: 2rem">
    <p class="page-kicker">404</p>
    <h1 class="page-title">這頁不存在</h1>
    <p class="page-description">可能被我改過路徑，或是還沒寫出來。</p>
    <div class="hero-actions" style="justify-content: center; margin-top: 1.4rem">
      <a class="button button-primary" href="/">回首頁</a>
      <a class="button button-secondary" href="/search">全站搜尋</a>
    </div>
  </div>
</BaseLayout>
