---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { publishedPosts } from "../lib/collections";
import {
  githubRepositories,
  githubRepositoryPath,
} from "../data/github-repos";

const solutions = publishedPosts(await getCollection("solutions"));
const projects = publishedPosts(await getCollection("projects"));
const notes = publishedPosts(await getCollection("notes"));
const journal = publishedPosts(await getCollection("journal"));

const documents = [
  ...githubRepositories.map((repository) => ({
    kind: repository.kind === "troubleshooting" ? "GitHub 問題紀錄" : "GitHub 專案",
    title: repository.title,
    description: repository.description,
    tags: [repository.language, ...repository.topics].filter(Boolean),
    url: githubRepositoryPath(repository),
    date: repository.pushedAt,
    body: repository.readme.replace(/```[\s\S]*?```/g, " ").slice(0, 2000),
  })),
  ...solutions.map((entry) => ({
    kind: "Problem & Solutions",
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    url: `/solutions/${entry.id}/`,
    date: entry.data.pubDate.toISOString(),
    body: (entry.body ?? "").replace(/```[\s\S]*?```/g, " ").slice(0, 1200),
  })),
  ...projects.map((entry) => ({
    kind: "Projects",
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    url: `/projects/${entry.id}/`,
    date: entry.data.pubDate.toISOString(),
    body: (entry.body ?? "").replace(/```[\s\S]*?```/g, " ").slice(0, 1200),
  })),
  ...notes.map((entry) => ({
    kind: "Learning Notes",
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    url: `/notes/${entry.id}/`,
    date: entry.data.pubDate.toISOString(),
    body: (entry.body ?? "").replace(/```[\s\S]*?```/g, " ").slice(0, 1200),
  })),
  ...journal.map((entry) => ({
    kind: "生活",
    title: entry.data.title,
    description: entry.data.description,
    tags: entry.data.tags,
    url: `/journal/${entry.id}/`,
    date: entry.data.pubDate.toISOString(),
    body: (entry.body ?? "").replace(/```[\s\S]*?```/g, " ").slice(0, 1200),
  })),
];
---

<BaseLayout title="全站搜尋" description="搜尋這個部落格的文章標題、內容與標籤。">
  <header class="page-heading">
    <p class="page-kicker">Search</p>
    <h1 class="page-title">全站搜尋</h1>
    <p class="page-description">想找什麼就打什麼，會搜文章標題、內文跟標籤。</p>
  </header>

  <label class="search-box">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m21 21-4.3-4.3"></path>
    </svg>
    <input id="search-input" type="search" placeholder="例如：pnpm、執行原則、雜湊……" autocomplete="off" />
  </label>

  <div id="search-results" class="search-results" aria-live="polite"></div>

  <script define:vars={{ documents }}>
    const input = document.querySelector("#search-input");
    const results = document.querySelector("#search-results");
    if (!input || !results) throw new Error("Search UI is missing.");

    function search(query) {
      const terms = query.toLocaleLowerCase().split(/\s+/).filter(Boolean);
      return documents
        .map((doc) => {
          const title = doc.title.toLocaleLowerCase();
          const description = doc.description.toLocaleLowerCase();
          const body = doc.body.toLocaleLowerCase();
          const tags = doc.tags.join(" ").toLocaleLowerCase();
          let score = 0;
          for (const term of terms) {
            if (title.includes(term)) score += 4;
            if (tags.includes(term)) score += 3;
            if (description.includes(term)) score += 2;
            if (body.includes(term)) score += 1;
          }
          return { doc, score };
        })
        .filter((item) => item.score > 0)
        .sort((left, right) => right.score - left.score)
        .slice(0, 30)
        .map((item) => item.doc);
    }

    function render(items) {
      if (items.length === 0) {
        results.innerHTML = '<p class="empty-state">沒有符合的結果，試試更短的關鍵字。</p>';
        return;
      }
      results.innerHTML = items
        .map((item) => {
          const date = new Date(item.date);
          const label = `${date.getFullYear()}-${String(date.getMonth() + 1).padStart(2, "0")}-${String(date.getDate()).padStart(2, "0")}`;
          return `
            <article class="post-card">
              <div class="post-card-meta"><span>${label}</span><span>${item.kind}</span></div>
              <h3><a href="${item.url}">${item.title}</a></h3>
              <p>${item.description}</p>
            </article>
          `;
        })
        .join("");
    }

    input.addEventListener("input", () => {
      const query = input.value.trim();
      render(query ? search(query) : []);
    });

    const initial = new URLSearchParams(location.search).get("q");
    if (initial) {
      input.value = initial;
      render(search(initial));
    }
  </script>
</BaseLayout>
