---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byNewest, publishedPosts } from "../../lib/collections";
import { formatDate } from "../../lib/format";

const selectedTag = Astro.url.searchParams.get("tag");
const entries = byNewest(publishedPosts(await getCollection("notes")));
const filtered = selectedTag
  ? entries.filter((entry) => entry.data.tags.map((tag) => tag.toLowerCase()).includes(selectedTag.toLowerCase()))
  : entries;
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
---

<BaseLayout title="學習筆記" description="一些不成熟的突發奇想">
  <header class="page-heading">
    <p class="page-kicker">隨手筆記</p>
    <h1 class="page-title">學習筆記</h1>
    <p class="page-description">
      系統化教材放在 CS Notes
    </p>
  </header>

  <div class="filter-strip" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.4rem">
    {tags.map((tag) => (
      <a class:list={["tag-pill", selectedTag === tag.toLowerCase() && "tag-pill-accent"]} href={`/notes?tag=${tag.toLowerCase()}`}>
        {tag}
      </a>
    ))}
  </div>

  {filtered.length === 0 ? (
    <p class="empty-state">目前還沒有學習筆記。</p>
  ) : (
    <div class="article-list">
      {filtered.map((entry) => (
        <a class="article-row" href={`/notes/${entry.id}/`}>
          <time class="article-row-date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">{entry.data.course ?? "筆記"}</span>
            <strong>{entry.data.title}</strong>
            <span>{entry.data.description}</span>
            <span class="article-row-tags">{entry.data.tags.slice(0, 3).join(" · ")}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  )}
</BaseLayout>
