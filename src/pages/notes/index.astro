---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import PostCard from "../../components/PostCard.astro";
import { byNewest, publishedPosts } from "../../lib/collections";

const selectedTag = Astro.url.searchParams.get("tag");
const entries = byNewest(publishedPosts(await getCollection("notes")));
const filtered = selectedTag
  ? entries.filter((entry) => entry.data.tags.map((tag) => tag.toLowerCase()).includes(selectedTag.toLowerCase()))
  : entries;
const tags = [...new Set(entries.flatMap((entry) => entry.data.tags))];
---

<BaseLayout title="學習筆記" description="讀書與實作後的第一手心得，寫給以後的自己看。">
  <header class="page-heading">
    <p class="page-kicker">隨手筆記</p>
    <h1 class="page-title">學習筆記</h1>
    <p class="page-description">
      系統化教材放在 CS Daily Knowledge；這裡記的是讀書跟實作當下最直接的想法，亂一點也沒關係。
    </p>
  </header>

  <div class="filter-strip" style="display:flex;flex-wrap:wrap;gap:0.5rem;margin-bottom:1.4rem">
    {tags.map((tag) => (
      <a class:list={["tag-pill", selectedTag === tag.toLowerCase() && "tag-pill-accent"]} href={`/notes?tag=${tag.toLowerCase()}`}>
        {tag}
      </a>
    ))}
  </div>

  {filtered.length === 0 ? (
    <p class="empty-state">這個標籤還沒有筆記。</p>
  ) : (
    <div class="card-grid">
      {filtered.map((entry) => (
        <PostCard
          href={`/notes/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          pubDate={entry.data.pubDate}
          tags={entry.data.tags}
          kind={entry.data.course ?? "筆記"}
          tagBase="/notes"
        />
      ))}
    </div>
  )}
</BaseLayout>
