---
import { getCollection, render } from "astro:content";
import ArticleLayout from "../../layouts/ArticleLayout.astro";
import { extractHeadings } from "../../lib/headings";
import { readingTime } from "../../lib/collections";

export async function getStaticPaths() {
  const entries = await getCollection("notes");
  return entries
    .filter((entry) => entry.data.status !== "draft")
    .map((entry) => ({
      params: { slug: entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const headings = extractHeadings(entry.body ?? "");
const all = (await getCollection("notes")).filter((item) => item.data.status !== "draft");
const related = all
  .filter((item) => item.id !== entry.id)
  .map((item) => ({
    item,
    score: item.data.tags.filter((tag) => entry.data.tags.includes(tag)).length,
  }))
  .sort((left, right) => right.score - left.score)
  .slice(0, 2)
  .map(({ item }) => ({
    title: item.data.title,
    description: item.data.description,
    url: `/notes/${item.id}/`,
    kind: item.data.course ?? "筆記",
  }));
---

<ArticleLayout
  title={entry.data.title}
  description={entry.data.description}
  pubDate={entry.data.pubDate}
  updatedDate={entry.data.updatedDate}
  tags={entry.data.tags}
  kind={entry.data.course ?? "筆記"}
  toc={headings}
  tagBase="/notes"
  readingTime={readingTime(entry.body ?? "")}
  backHref="/notes"
  backLabel="回到學習筆記"
  related={related}
  repository={entry.data.relatedKnowledge}
>
  <Content />
</ArticleLayout>
