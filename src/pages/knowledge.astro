---
import BaseLayout from "../layouts/BaseLayout.astro";
import { knowledgeFacts, knowledgeSpotlight } from "../data/knowledge";
---

<BaseLayout title="CS Notes" description="宇奕整理的資工與資安教材，這裡是入口與精選。">
  <header class="page-heading">
    <p class="page-kicker">我的另一個站</p>
    <h1 class="page-title">CS Notes</h1>
    <p class="page-description">
      每天一篇資安教材，有圖有測驗。它自己住一個 Repository，這裡只放介紹跟幾篇精選。
    </p>
  </header>

  <section class="note-box">
    目前有 {knowledgeFacts.publishedLessons} 篇。兩個站互相放連結，但誰掛了都不影響另一個。
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>先看這幾篇</h2>
      <a href={knowledgeFacts.url} target="_blank" rel="noreferrer noopener">進入完整知識庫 →</a>
    </div>
    <div class="article-list">
      {knowledgeSpotlight.map((lesson) => (
        <a class="article-row" href={lesson.url} target="_blank" rel="noreferrer noopener">
          <span class="article-row-date">{lesson.id}</span>
          <span class="article-row-body">
            <strong>{lesson.title}</strong>
            <span>{lesson.summary}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>連結</h2>
    </div>
    <div class="hero-actions">
      <a class="button button-secondary" href={knowledgeFacts.repository} target="_blank" rel="noreferrer noopener">GitHub Repository</a>
      <a class="button button-secondary" href={knowledgeFacts.url} target="_blank" rel="noreferrer noopener">正式網站</a>
    </div>
  </section>
</BaseLayout>
