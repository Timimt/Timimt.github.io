---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { byNewest, publishedPosts, readingTime } from "../lib/collections";
import { formatDate } from "../lib/format";
import { knowledgeFacts } from "../data/knowledge";
import { site } from "../data/site";
import {
  githubRepositories,
  githubRepositoryPath,
} from "../data/github-repos";

const solutions = byNewest(publishedPosts(await getCollection("solutions")));
const projects = byNewest(publishedPosts(await getCollection("projects")));
const notes = byNewest(publishedPosts(await getCollection("notes")));
const journal = byNewest(publishedPosts(await getCollection("journal")));
const latest = byNewest([...solutions, ...projects, ...notes, ...journal]).slice(0, 8);
const currentProject = projects.find((entry) => entry.id === "cs-daily-knowledge") ?? projects[0];

function collectionPath(collection: string): string {
  if (collection === "solutions") return "/solutions";
  if (collection === "projects") return "/projects";
  if (collection === "journal") return "/journal";
  return "/notes";
}

function collectionLabel(collection: string): string {
  if (collection === "solutions") return "問題";
  if (collection === "projects") return "專案";
  if (collection === "journal") return "生活";
  return "筆記";
}
---

<BaseLayout title={site.title} description={site.description}>
  <section class="home-intro">
    <p class="intro-overline">Personal Blog / Technical Journal / Life Notes</p>
    <h1>宇奕_zoran</h1>
    <div class="intro-copy">
      <p>你好，我是宇奕。目前就讀於中原大學資訊工程學系。</p>
      <p>
        平常喜歡研究計算機相關的技術，也喜歡動手做一些有趣的東西。這裡記錄我學過的知識、解決過的問題，以及一些生活中的想法。
      </p>
    </div>
    <div class="intro-links">
      <a href="/about">關於我</a>
      <a href={site.github} target="_blank" rel="noreferrer noopener">GitHub</a>
      <a href="/rss.xml">RSS</a>
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-heading">
      <h2>最近寫的</h2>
      <span>從新到舊</span>
    </div>
    <div class="article-list">
      {latest.map((entry) => (
        <a class="article-row" href={`${collectionPath(entry.collection)}/${entry.id}/`}>
          <time class="article-row-date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">{collectionLabel(entry.collection)}</span>
            <strong>{entry.data.title}</strong>
            <span>{entry.data.description}</span>
            <span class="article-row-tags">
              {entry.data.tags.slice(0, 3).join(" · ")}
              {entry.body ? ` · ${readingTime(entry.body)} 分鐘` : ""}
            </span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-section">
    <div class="home-section-heading">
      <h2>GitHub 最近更新</h2>
      <span>{githubRepositories.length} 個 Repository</span>
    </div>
    <div class="article-list">
      {githubRepositories.map((repository) => (
        <a class="article-row" href={githubRepositoryPath(repository)}>
          <time class="article-row-date" datetime={repository.pushedAt}>
            {formatDate(repository.pushedAt)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">
              {repository.kind === "troubleshooting" ? "問題紀錄" : "專案"}
            </span>
            <strong>{repository.title}</strong>
            <span>{repository.description}</span>
            <span class="article-row-tags">
              {repository.language ?? "Repository"}
              {repository.topics.length ? ` · ${repository.topics.slice(0, 3).join(" · ")}` : ""}
            </span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>

  <section class="home-mosaic">
    <div class="now-block">
      <p class="section-label">現在</p>
      {currentProject ? (
        <>
          <h2>{currentProject.data.title}</h2>
          <p>{currentProject.data.description}</p>
          <div class="plain-links">
            <a href={`/projects/${currentProject.id}/`}>專案紀錄</a>
            {currentProject.data.links.map((link) => (
              <a href={link.url} target="_blank" rel="noreferrer noopener">{link.label}</a>
            ))}
          </div>
        </>
      ) : (
        <p>最近在整理這個網站。</p>
      )}
    </div>

    <div class="life-block">
      <p class="section-label">生活</p>
      <h2>不是每篇都要跟程式有關</h2>
      <p>
        大學生活、走過的地方、突然想到的事，也會放在這裡。生活不是技術文章旁邊的裝飾。
      </p>
      {journal.length === 0 ? (
        <p>目前還沒有文章。等真的有想留下的東西，再放進來。</p>
      ) : (
        journal.slice(0, 2).map((entry) => (
          <a class="plain-link-row" href={`/journal/${entry.id}/`}>
            <span>{entry.data.title}</span>
            <span>{formatDate(entry.data.pubDate)}</span>
          </a>
        ))
      )}
      <a class="text-link" href="/journal">看全部生活隨筆 →</a>
    </div>
  </section>

  <section class="knowledge-strip">
    <div>
      <p class="section-label">另一個長期專案</p>
      <h2>CS Daily Knowledge</h2>
      <p>
        目前有 {knowledgeFacts.publishedLessons} 篇資安教材。它有自己的網站與 Repository，和這個 Blog 各自獨立。
      </p>
    </div>
    <div class="plain-links">
      <a href="/knowledge">介紹與精選</a>
      <a href={knowledgeFacts.url} target="_blank" rel="noreferrer noopener">前往知識庫 ↗</a>
    </div>
  </section>
</BaseLayout>
