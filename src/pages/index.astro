---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import { byNewest, publishedPosts } from "../lib/collections";
import { knowledgeFacts, knowledgeSpotlight } from "../data/knowledge";
import { site } from "../data/site";

const solutions = byNewest(publishedPosts(await getCollection("solutions")));
const projects = byNewest(publishedPosts(await getCollection("projects")));
const notes = byNewest(publishedPosts(await getCollection("notes")));
const latest = byNewest([...solutions, ...projects, ...notes]).slice(0, 6);
---

<BaseLayout title={site.title}>
  <section class="hero">
    <div class="hero-inner">
      <p class="hero-kicker">你好，我是宇奕_zoran</p>
      <h1 class="hero-title">這裡放我的筆記、踩過的坑，還有幾個自己做的東西。</h1>
      <p class="hero-copy">
        寫得很慢，但每一篇都是我真的碰過的。有資安教材、修到半夜的奇怪問題，也有做到一半的專案。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/about">關於我</a>
        <a class="button button-ghost" href="/solutions">看問題紀錄</a>
        <a class="button button-ghost" href={site.knowledge} target="_blank" rel="noreferrer noopener">CS Daily Knowledge</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>最近寫的</h2>
      <a href="/solutions">全部 →</a>
    </div>
    <div class="card-grid">
      {latest.map((entry) => {
        const base = entry.collection === "solutions"
          ? "/solutions"
          : entry.collection === "projects"
            ? "/projects"
            : "/notes";
        const kind = entry.collection === "solutions"
          ? "問題解法"
          : entry.collection === "projects"
            ? "專案"
            : "學習筆記";
        return (
          <PostCard
            href={`${base}/${entry.id}/`}
            title={entry.data.title}
            description={entry.data.description}
            pubDate={entry.data.pubDate}
            tags={entry.data.tags}
            kind={kind}
            tagBase={base}
          />
        );
      })}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>我另外維護的知識庫</h2>
      <a href={knowledgeFacts.url} target="_blank" rel="noreferrer noopener">前往知識庫 →</a>
    </div>
    <p class="note-box">
      這是一個每天一篇的資安教材站，目前有 {knowledgeFacts.publishedLessons} 篇，每篇都有我畫的圖跟測驗。這裡只放幾篇我覺得值得先看的，完整內容在那個站上。
    </p>
    <div class="card-grid" style="margin-top: 1rem">
      {knowledgeSpotlight.map((lesson) => (
        <article class="post-card">
          <div class="post-card-meta"><span>精選教材</span></div>
          <h3><a href={lesson.url} target="_blank" rel="noreferrer noopener">{lesson.title}</a></h3>
          <p>{lesson.summary}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <h2>做過的東西</h2>
      <a href="/projects">所有專案 →</a>
    </div>
    <div class="card-grid">
      {projects.slice(0, 2).map((entry) => (
        <PostCard
          href={`/projects/${entry.id}/`}
          title={entry.data.title}
          description={entry.data.description}
          pubDate={entry.data.pubDate}
          tags={entry.data.tags}
          kind="專案"
          tagBase="/projects"
        />
      ))}
    </div>
  </section>
</BaseLayout>
