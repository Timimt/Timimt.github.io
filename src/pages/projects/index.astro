---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { byNewest, publishedPosts } from "../../lib/collections";
import { formatDate } from "../../lib/format";
import {
  githubProjects,
  githubRepositoryPath,
} from "../../data/github-repos";

const entries = byNewest(publishedPosts(await getCollection("projects")));
---

<BaseLayout title="做過的東西" description="自己做過或在做的專案">
  <header class="page-heading">
    <p class="page-kicker">我的專案</p>
    <h1 class="page-title">做過的東西</h1>
    <p class="page-description">
      有些是已經完成的作品，有些還在慢慢修改，做的時候遇到什麼問題、最後怎麼解決，如果有值得記下來的就會放在這裡
    </p>
  </header>

  <section>
    <div class="home-section-heading">
      <h2>站內深入紀錄</h2>
      <span>手寫整理</span>
    </div>
    {entries.length === 0 ? (
      <p class="empty-state">還沒有站內專案紀錄。</p>
    ) : (
      <div class="article-list">
        {entries.map((entry) => (
          <a class="article-row" href={`/projects/${entry.id}/`}>
            <time class="article-row-date" datetime={entry.data.pubDate.toISOString()}>
              {formatDate(entry.data.pubDate)}
            </time>
            <span class="article-row-body">
              <span class="article-row-kind">{entry.data.status === "active" ? "進行中" : "專案"}</span>
              <strong>{entry.data.title}</strong>
              <span>{entry.data.description}</span>
              <span class="article-row-tags">{entry.data.stack.slice(0, 4).join(" · ")}</span>
            </span>
            <span class="article-row-arrow">↗</span>
          </a>
        ))}
      </div>
    )}
  </section>

  <section class="section">
    <div class="home-section-heading">
      <h2>GitHub Repositories</h2>
      <span>建置時從 GitHub 同步</span>
    </div>
    <div class="article-list">
      {githubProjects.map((repository) => (
        <a class="article-row" href={githubRepositoryPath(repository)}>
          <time class="article-row-date" datetime={repository.pushedAt}>
            {formatDate(repository.pushedAt)}
          </time>
          <span class="article-row-body">
            <span class="article-row-kind">{repository.language ?? "Repository"}</span>
            <strong>{repository.title}</strong>
            <span>{repository.description}</span>
            <span class="article-row-tags">{repository.topics.slice(0, 4).join(" · ")}</span>
          </span>
          <span class="article-row-arrow">↗</span>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>
